<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameClub.Client.Avalonia</RootNamespace>
    <AssemblyName>GameClub.Client.Avalonia.V2</AssemblyName>
    <BaseOutputPath>bin-v2\</BaseOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);GAMECLUB_V2_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameClub.Client.Core\GameClub.Client.Core.csproj" />
    <Compile Include="**\*.cs" Exclude="Development\**\*.cs;obj\**\*.cs;obj-v2\**\*.cs;bin\**\*.cs;bin-v2\**\*.cs" />
    <AvaloniaResource Include="Assets\HubShell.ico" />
  </ItemGroup>
</Project>
