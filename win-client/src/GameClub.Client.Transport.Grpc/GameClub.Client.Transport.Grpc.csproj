<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameClub.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Protobuf_ProtoRoot>..\..\..\backend\proto</Protobuf_ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="All" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameClub.Client.Core\GameClub.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\backend\proto\gameclub\v2\offline_session_snapshot.proto" GrpcServices="None" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v2\events.proto" GrpcServices="None" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v2\offline_session_service.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v2\device_control_service.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GameClub.Client\Infrastructure\MacAddressProvider.cs" Link="Infrastructure\MacAddressProvider.cs" />
  </ItemGroup>
</Project>
