<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GameClub.Client.Avalonia.AccountHistoryWindow"
    Width="620"
    Height="700"
    MinWidth="520"
    MinHeight="520"
    CanResize="False"
    SystemDecorations="None"
    Title="История аккаунта"
    Background="{DynamicResource PageBackgroundBrush}"
>
  <Border
        Background="{DynamicResource PageBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="14"
        ClipToBounds="True"
    >
    <Grid RowDefinitions="Auto,*">
      <Border
            Padding="18,14"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
        >
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock
                Text="HUBSHELL"
                Foreground="{DynamicResource AccentBrush}"
                FontSize="11"
                FontWeight="Bold"
            />
            <TextBlock
                Text="История аккаунта"
                Foreground="{DynamicResource PrimaryTextBrush}"
                FontSize="20"
                FontWeight="SemiBold"
            />
          </StackPanel>
          <Button
              Name="CloseAccountHistoryButton"
              Grid.Column="1"
              Click="CloseWindow"
              Classes="history-close"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              ToolTip.Tip="Закрыть историю"
          >
            <TextBlock
                Text="×"
                FontSize="20"
                LineHeight="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
            />
          </Button>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" Margin="18" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <Border
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="13"
          >
            <StackPanel Spacing="8">
              <TextBlock Text="Операции баланса" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              <ItemsControl Name="AccountBalanceHistory" ItemsSource="{Binding PortalBalanceHistory}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="13"
          >
            <StackPanel Spacing="8">
              <TextBlock Text="Покупки" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              <ItemsControl Name="AccountPurchaseHistory" ItemsSource="{Binding PortalPurchaseHistory}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="13"
          >
            <StackPanel Spacing="8">
              <TextBlock Text="Сессии" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              <ItemsControl Name="AccountSessionHistory" ItemsSource="{Binding PortalSessionHistory}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
