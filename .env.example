# Local Docker Compose defaults. Do not use these values in production.
GAMECLUB_ENVIRONMENT=dev
GAMECLUB_DB_PASSWORD=gameclub-local-only
GAMECLUB_JWT_SECRET=gameclub-local-jwt-secret-change-me
GAMECLUB_DEV_OPERATOR_USERNAME=operator
GAMECLUB_DEV_OPERATOR_PASSWORD=change-me-locally
GAMECLUB_DEVICE_BOOTSTRAP_TOKEN=change-me-locally

# Host ports. Container-to-container ports remain internal to Docker Compose.
GAMECLUB_FRONTEND_PORT=3100
GAMECLUB_BIND_HOST=0.0.0.0
GAMECLUB_HTTP_PORT=8100
GAMECLUB_GRPC_PORT=51051
GAMECLUB_POSTGRES_PORT=55432
GAMECLUB_REDIS_PORT=56379
GAMECLUB_PYROSCOPE_PORT=4040

# Browser-side build values.
VITE_API_URL=/api/v1
VITE_GAMECLUB_DATA_MODE=live
STEAM_GUEST_STATION_KEY_PEPPER=MSqu88uRmw5OWQr8NqZArJ0HGHx7FEY7N2dByjFlcu0=
STEAM_GUEST_MASTER_KEY=MSqu88uRmw5OWQr8NqZArJ0HGHx7FEY7N2dByjFlcu0=
