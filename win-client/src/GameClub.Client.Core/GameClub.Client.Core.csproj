<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameClub.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Shared portable source remains grouped by domain/application/infrastructure
       until a separate file-layout refactor is approved. It is consumed by the
       Avalonia hosts and is not a second UI implementation. -->
  <ItemGroup>
    <!-- MainViewModel converts transport failures to portable UI state. -->
    <PackageReference Include="Grpc.Core.Api" Version="2.66.0" />
    <Compile Include="..\GameClub.Client\Application\**\*.cs" Link="Application\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\GameClub.Client\Domain\**\*.cs" Link="Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\GameClub.Client\Infrastructure\DeviceEnrollmentPendingException.cs" Link="Infrastructure\DeviceEnrollmentPendingException.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\EndpointPolicy.cs" Link="Infrastructure\EndpointPolicy.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\EnvironmentAccessCredentialVerifier.cs" Link="Infrastructure\EnvironmentAccessCredentialVerifier.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\PasswordHashVerifier.cs" Link="Infrastructure\PasswordHashVerifier.cs" />
    <Compile Include="..\GameClub.Client\Presentation\ClientPortalHistoryFormatter.cs" Link="Presentation\ClientPortalHistoryFormatter.cs" />
    <Compile Include="..\GameClub.Client\Presentation\MainViewModel.cs" Link="Presentation\MainViewModel.cs" />
  </ItemGroup>
</Project>
