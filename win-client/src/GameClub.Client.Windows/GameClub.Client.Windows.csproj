<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- This is a Windows deployment host, but no WindowsAppSDK API leaks
         into its UI. net8.0 keeps restore/build verifiable from Linux; publish
         is restricted to win-x86/win-x64/win-arm64 below. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameClub.Client.Windows</RootNamespace>
    <AssemblyName>HubShell</AssemblyName>
    <Product>HubShell</Product>
    <ApplicationIcon>..\GameClub.Client.Avalonia\Assets\HubShell.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- Specify one Windows RID at publish time. Restoring every Windows
         runtime pack is unnecessary for Linux source verification. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Local Linux verification may run without NuGet audit network access. -->
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <GameClubEnvironment Condition="'$(GameClubEnvironment)' == ''">production</GameClubEnvironment>
    <GameClubGrpcAddress Condition="'$(GameClubGrpcAddress)' == ''">https://api.gameclub.local:51051</GameClubGrpcAddress>
    <GameClubV2EventsHttpAddress Condition="'$(GameClubV2EventsHttpAddress)' == ''"></GameClubV2EventsHttpAddress>
    <GameClubV2SnapshotPublicKeys Condition="'$(GameClubV2SnapshotPublicKeys)' == ''"></GameClubV2SnapshotPublicKeys>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HubShellReleaseId" Value="$(HubShellReleaseId)" />
    <AssemblyMetadata Include="GameClubEnvironment" Value="$(GameClubEnvironment)" />
    <AssemblyMetadata Include="GameClubGrpcAddress" Value="$(GameClubGrpcAddress)" />
    <AssemblyMetadata Include="GameClubV2EventsHttpAddress" Value="$(GameClubV2EventsHttpAddress)" />
    <AssemblyMetadata Include="GameClubV2SnapshotPublicKeys" Value="$(GameClubV2SnapshotPublicKeys)" />
    <ProjectReference Include="..\GameClub.Client.Avalonia\GameClub.Client.Avalonia.csproj" />
    <ProjectReference Include="..\GameClub.Client.Core\GameClub.Client.Core.csproj" />
    <ProjectReference Include="..\GameClub.Client.Transport.Grpc\GameClub.Client.Transport.Grpc.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GameClub.Client\Infrastructure\Updates\*.cs" Link="Infrastructure\Updates\%(Filename)%(Extension)" />
    <Compile Include="..\GameClub.Client\Infrastructure\DeploymentSettings.cs" Link="Infrastructure\DeploymentSettings.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\JsonlOfflineJournal.cs" Link="Infrastructure\JsonlOfflineJournal.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\ProtectedV2LocalLedgerStore.cs" Link="Infrastructure\ProtectedV2LocalLedgerStore.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\NativeTrayIcon.cs" Link="Infrastructure\NativeTrayIcon.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\StartupDiagnostics.cs" Link="Infrastructure\StartupDiagnostics.cs" />
    <Compile Include="..\GameClub.Client\Infrastructure\WindowsWorkstationPowerController.cs" Link="Infrastructure\WindowsWorkstationPowerController.cs" />
  </ItemGroup>
</Project>
