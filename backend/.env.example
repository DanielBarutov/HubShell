GAMECLUB_ENVIRONMENT=dev
GAMECLUB_POSTGRES_DSN=postgresql+asyncpg://gameclub:change-me-locally@localhost:5432/gameclub
GAMECLUB_REDIS_URL=redis://localhost:6379/0
GAMECLUB_HTTP_HOST=127.0.0.1
GAMECLUB_HTTP_PORT=8000
GAMECLUB_GRPC_HOST=127.0.0.1
GAMECLUB_GRPC_PORT=50051
# Leave empty for local dev only. Production gRPC requires all TLS deployment values.
GAMECLUB_GRPC_TLS_CERT_FILE=
GAMECLUB_GRPC_TLS_KEY_FILE=
GAMECLUB_GRPC_TLS_CLIENT_CA_FILE=
GAMECLUB_GRPC_TLS_REQUIRE_CLIENT_CERTIFICATE=false
GAMECLUB_JWT_SECRET=change-me-locally
GAMECLUB_JWT_ISSUER=gameclub-backend
GAMECLUB_JWT_AUDIENCE=gameclub-clients
GAMECLUB_JWT_ACCESS_TTL_SECONDS=900
GAMECLUB_JWT_REFRESH_TTL_SECONDS=7776000
GAMECLUB_DEV_OPERATOR_USERNAME=operator
GAMECLUB_DEV_OPERATOR_PASSWORD=change-me-locally
GAMECLUB_DEVICE_BOOTSTRAP_TOKEN=change-me-locally
GAMECLUB_WORKSTATION_STALE_AFTER_SECONDS=45
GAMECLUB_WORKSTATION_OFFLINE_AFTER_SECONDS=120
GAMECLUB_WORKSTATION_COMMAND_TTL_SECONDS=120
GAMECLUB_RESERVATION_GRACE_PERIOD_MINUTES=15
GAMECLUB_RESERVATION_SWEEP_INTERVAL_SECONDS=60
GAMECLUB_BILLING_RECONCILIATION_INTERVAL_SECONDS=60
