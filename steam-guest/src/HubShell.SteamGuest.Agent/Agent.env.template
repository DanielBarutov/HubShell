# Адрес Steam Guest Server в локальной сети.
HUBSHELL_STEAM_SERVER_URL=http://192.168.1.10:8200/

# HTTP разрешён только для изолированной локальной сети клуба.
HUBSHELL_STEAM_ALLOW_HTTP=true

# Эти значения выдаёт администратор для конкретного игрового ПК.
HUBSHELL_STEAM_STATION_ID=
HUBSHELL_STEAM_STATION_KEY=

# Можно не менять, если Steam установлен по стандартному пути.
HUBSHELL_STEAM_EXE=C:\Program Files (x86)\Steam\steam.exe
