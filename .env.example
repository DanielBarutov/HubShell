# Local Docker Compose defaults. Do not use these values in production.
GAMECLUB_ENVIRONMENT=dev
GAMECLUB_DB_PASSWORD=gameclub-local-only
GAMECLUB_JWT_SECRET=gameclub-local-jwt-secret-change-me
GAMECLUB_DEV_OPERATOR_USERNAME=operator
GAMECLUB_DEV_OPERATOR_PASSWORD=change-me-locally
GAMECLUB_DEVICE_BOOTSTRAP_TOKEN=change-me-locally

GAMECLUB_FRONTEND_PORT=3000
GAMECLUB_HTTP_PORT=8000
GAMECLUB_GRPC_PORT=50051
GAMECLUB_POSTGRES_PORT=5432
GAMECLUB_REDIS_PORT=6379

# Browser-side build values.
VITE_API_URL=/api/v1
VITE_GAMECLUB_DATA_MODE=live
