<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GameClub.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseRidGraph>true</UseRidGraph>
    <EnableMsixTooling>true</EnableMsixTooling>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <!--
      The proto files live outside the project directory and use repository-
      relative imports such as gameclub/v1/sessions.proto. Tell Grpc.Tools
      which directory is the import root instead of relying on the individual
      source file directories.
    -->
    <Protobuf_ProtoRoot>..\..\..\backend\proto</Protobuf_ProtoRoot>
    <GameClubEnvironment Condition="'$(GameClubEnvironment)' == ''">production</GameClubEnvironment>
    <GameClubAuthAddress Condition="'$(GameClubAuthAddress)' == ''">https://api.gameclub.local:8100</GameClubAuthAddress>
    <GameClubGrpcAddress Condition="'$(GameClubGrpcAddress)' == ''">https://api.gameclub.local:51051</GameClubGrpcAddress>

    <!--
      WinUI XAML Pass1 inspects the C# project before the regular C# compile.
      Generate protobuf consumers first so the XAML compiler can resolve the
      GameClub.Client.Contracts namespace on a clean publish.
    -->
    <MarkupCompilePass1DependsOn>
      Protobuf_Compile;
      $(MarkupCompilePass1DependsOn)
    </MarkupCompilePass1DependsOn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GameClubEnvironment" Value="$(GameClubEnvironment)" />
    <AssemblyMetadata Include="GameClubAuthAddress" Value="$(GameClubAuthAddress)" />
    <AssemblyMetadata Include="GameClubGrpcAddress" Value="$(GameClubGrpcAddress)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240829007" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="All" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\system.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\workstations.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\clients.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\catalog.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\reservations.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\sessions.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\billing.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\cash_shifts.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\..\backend\proto\gameclub\v1\analytics.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
