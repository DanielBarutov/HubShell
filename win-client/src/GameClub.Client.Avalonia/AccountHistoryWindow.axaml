<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GameClub.Client.Avalonia.AccountHistoryWindow"
    Width="520"
    SizeToContent="Height"
    MaxHeight="650"
    MinWidth="390"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    SystemDecorations="None"
    Title="История аккаунта"
    Icon="/Assets/HubShell.ico"
    Background="#020D12"
>
  <Border
        Background="#020D12"
        BorderBrush="#246176"
        BorderThickness="1"
        CornerRadius="14"
        ClipToBounds="True"
    >
    <Grid RowDefinitions="Auto,Auto">
      <Border
            Padding="16,12"
            Background="#0B2430"
            BorderBrush="#246176"
            BorderThickness="0,0,0,1"
        >
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock
                Text="HUBSHELL"
                Foreground="{DynamicResource AccentBrush}"
                FontSize="11"
                FontWeight="Bold"
            />
            <TextBlock
                Text="История аккаунта"
                Foreground="{DynamicResource PrimaryTextBrush}"
                FontSize="18"
                FontWeight="SemiBold"
            />
          </StackPanel>
          <Button
              Name="CloseAccountHistoryButton"
              Grid.Column="1"
              Click="CloseWindow"
              Classes="widget-secondary"
              Width="30" Height="30" Padding="0"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              ToolTip.Tip="Закрыть историю"
          >
            <TextBlock
                Text="×"
                FontSize="20"
                LineHeight="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
            />
          </Button>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" Margin="12" MaxHeight="520" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <Border
              Background="#0B2430"
              BorderBrush="#246176"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12"
          >
            <StackPanel Spacing="8">
              <TextBlock Text="Операции баланса" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              <ItemsControl Name="AccountBalanceHistory" ItemsSource="{Binding PortalBalanceHistory}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border
              Background="#0B2430"
              BorderBrush="#246176"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12"
          >
            <StackPanel Spacing="8">
              <TextBlock Text="Покупки" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              <ItemsControl Name="AccountPurchaseHistory" ItemsSource="{Binding PortalPurchaseHistory}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border
              Background="#0B2430"
              BorderBrush="#246176"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12"
          >
            <StackPanel Spacing="8">
              <TextBlock Text="Сессии" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
              <ItemsControl Name="AccountSessionHistory" ItemsSource="{Binding PortalSessionHistory}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
