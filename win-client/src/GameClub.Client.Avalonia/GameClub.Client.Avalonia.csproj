<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameClub.Client.Avalonia</RootNamespace>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <DefineConstants>$(DefineConstants);GAMECLUB_V2_ONLY;GAMECLUB_LINUX_V2</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameClub.Client.Core\GameClub.Client.Core.csproj" GlobalPropertiesToRemove="GameClubV2Only" />
    <ProjectReference Include="..\GameClub.Client.Transport.Grpc\GameClub.Client.Transport.Grpc.csproj" />
    <Compile Remove="obj\**\*.cs;obj-v2\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Development\LocalBackendClientHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\HubShell.ico" />
  </ItemGroup>
</Project>
