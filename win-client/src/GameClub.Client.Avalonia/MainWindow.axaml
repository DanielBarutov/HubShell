<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GameClub.Client.Avalonia.MainWindow"
    Width="1120"
    Height="680"
    MinWidth="390"
    MinHeight="520"
    Title="HubShell"
    Icon="/Assets/HubShell.ico"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource PageBackgroundBrush}"
>
  <Border
        Name="WindowContentSurface"
        Background="{DynamicResource PageBackgroundBrush}"
        ClipToBounds="True"
    >
  <Grid
            Background="{DynamicResource PageBackgroundBrush}"
            KeyDown="RecordKeyActivity"
            PointerPressed="RecordPointerActivity"
        >
    <!-- Резервный экран для назначенного устройства, пока кабинет не передал snapshot. -->
    <Grid IsVisible="{Binding IsSecuredContentVisible}" Margin="24">
      <StackPanel MaxWidth="740" HorizontalAlignment="Center" Spacing="14">
        <TextBlock
                        Text="HUBSHELL"
                        Foreground="{DynamicResource AccentBrush}"
                        FontWeight="Bold"
                        FontSize="14"
                    />
        <Border
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                    >
          <StackPanel Spacing="10">
            <TextBlock
                                Text="Игровое место"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                            />
            <TextBlock
                                Text="{Binding CurrentWorkstationLabel}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                            />
            <TextBlock
                                Text="{Binding ConnectionMessage}"
                                Foreground="{Binding ConnectionColor}"
                                TextWrapping="Wrap"
                            />
            <TextBlock
                                Text="{Binding V2DeliveryStatus}"
                                Foreground="{DynamicResource SignalBrush}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                            />
            <TextBlock
                                Text="{Binding V2DeliveryMessage}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                IsVisible="{Binding HasV2ServerEventIssues}"
                            />
            <TextBlock
                                Text="{Binding V2DeliveryMessage}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                IsVisible="{Binding IsV2ServerEventTransportFailed}"
                            />
          </StackPanel>
        </Border>
        <Border
                        IsVisible="{Binding IsActiveSessionVisible}"
                        Background="#122130"
                        BorderBrush="#4D61D8FF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                    >
          <StackPanel Spacing="8">
            <TextBlock
                                Text="ТЕКУЩАЯ СЕССИЯ"
                                Foreground="{DynamicResource SignalBrush}"
                                FontSize="11"
                            />
            <TextBlock
                                Text="{Binding ActiveTimeSummary}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                            />
            <TextBlock
                                Text="{Binding ActiveSessionDescription}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                TextWrapping="Wrap"
                            />
            <Button
                                Click="StopCurrentSession"
                                IsEnabled="{Binding CanStopActiveSession}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentTextBrush}"
                            ><TextBlock
                                    Text="Завершить сессию"
                                    FontWeight="SemiBold"
                                /></Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Собственная непрозрачная поверхность: фон не открывает рабочий стол. -->
    <Grid IsVisible="{Binding IsAccessGateVisible}" Background="#07090D">
      <Image Name="AccessGateBackground" Source="/Assets/LoginBackground.png" Stretch="UniformToFill"/>
      <Border Background="#3007090D"/>
      <Grid RowDefinitions="Auto,*,Auto" Margin="28,22">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="48" Height="48" Background="{DynamicResource AccentBrush}" CornerRadius="14">
            <TextBlock Text="H" FontSize="34" FontWeight="Black" Foreground="#0B1605" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="HUBSHELL" Foreground="{DynamicResource AccentBrush}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,20">
          <Grid Width="1380" ColumnDefinitions="420,540,30,*">
            <Border Name="AccessLoginCard" Grid.Column="1" Padding="18,24,18,18" Background="#E6091417" BorderBrush="#3C5960" BorderThickness="1" CornerRadius="20">
              <StackPanel Spacing="16">
                <Border HorizontalAlignment="Center" Padding="28,12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="20" BoxShadow="0 0 22 0 #4058FF16">
                  <StackPanel Orientation="Horizontal" Spacing="20">
                    <Path Width="40" Height="36" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Data="M2,2 L34,2 L34,24 L2,24 Z M18,24 L18,32 M10,32 L26,32"/>
                    <TextBlock Text="{Binding CurrentWorkstationLabel}" MaxWidth="330" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}" FontSize="40" FontWeight="Bold"/>
                  </StackPanel>
                </Border>
                <StackPanel Spacing="8" IsVisible="{Binding IsUserLoginVisible}">
                  <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Добро <Run Text="пожаловать" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                  <TextBlock Text="Войдите в свой аккаунт, чтобы начать играть" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15"/>
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsPortalRegistrationVisible}">
                  <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Создайте <Run Text="аккаунт" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                  <TextBlock Text="Зарегистрируйтесь, чтобы начать играть" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15"/>
                </StackPanel>
                <Border Padding="20" Background="#80081213" BorderBrush="#293F43" BorderThickness="1" CornerRadius="12">
              <Grid RowDefinitions="*,Auto">
                <StackPanel
                                        IsVisible="{Binding IsUserLoginVisible}"
                                        Spacing="10"
                                    >
                  <TextBlock
                                            Text="Войти в аккаунт" IsVisible="False"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            FontSize="21"
                                            FontWeight="SemiBold"
                                        /><TextBlock
                                            Text="Никнейм или телефон и пароль" IsVisible="False"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        />
                  <TextBlock
                                            Margin="0,8,0,0"
                                            Text="Никнейм или телефон"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        /><TextBox
                                            Name="PortalIdentifierBox" Classes="neon-input"
                                            Watermark="+7 (9__) ___-__-__"
                                            TextChanged="PortalIdentifierChanged"
                                            MaxLength="64"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                        />
                  <TextBlock
                                            Text="Пароль"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        /><TextBox
                                            Name="PortalPasswordBox" Classes="neon-input"
                                            Watermark="От 4-ех символов"
                                            PasswordChar="●"
                                            TextChanged="PortalPasswordChanged"
                                            MaxLength="128"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                        />
                  <Button
                                            Name="PortalLoginButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="22" MinHeight="54"
                                            Classes="access-primary"
                                            Click="LoginPortal"
                                            IsEnabled="{Binding CanLoginPortal}"
                                            Margin="0,8,0,0"
                                        ><TextBlock
                                                Text="Войти"
                                                FontWeight="SemiBold"
                                            /></Button>
                  <Grid ColumnDefinitions="*,Auto,*" Margin="0,4"><Border Height="1" Background="#536365"/><TextBlock Grid.Column="1" Text="или" Margin="14,0" Foreground="{DynamicResource SecondaryTextBrush}"/><Border Grid.Column="2" Height="1" Background="#536365"/></Grid>
                  <Button
                                            Name="OpenPortalRegistrationButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="20" MinHeight="48"
                                            Classes="access-secondary"
                                            Click="OpenPortalRegistration"
                                        ><TextBlock
                                                Text="Создать аккаунт"
                                            /></Button>
                </StackPanel>

                <StackPanel
                                        IsVisible="{Binding IsPortalRegistrationVisible}"
                                        Spacing="10"
                                    >

                  <TextBlock
                                            Text="Никнейм"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        /><Grid><TextBox
                                            Name="PortalNicknameBox" Classes="neon-input" Padding="50,10,14,10" CornerRadius="10"
                                            Watermark="Введите никнейм"
                                            TextChanged="PortalNicknameChanged"
                                            MaxLength="64"
                                        /><Viewbox Width="22" Height="22" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="34" Height="34"><Path Data="M16,3 A6,6 0 1 1 15.9,3 M5,29 L5,24 Q5,19 16,19 Q27,19 27,24 L27,29 Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2"/></Canvas></Viewbox></Grid>
                  <TextBlock
                                            Text="Номер телефона"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        /><Grid><TextBox
                                            Name="PortalPhoneBox" Classes="neon-input" Padding="50,10,14,10"
                                            Watermark="+7 (9__) ___-__-__"
                                            TextChanged="PortalPhoneChanged"
                                            MaxLength="18"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                        /><Viewbox Width="22" Height="22" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="34" Height="34"><Path Data="M5,3 L10,3 L13,10 L9,14 Q12,21 19,24 L23,20 L30,23 L30,28 Q30,32 24,30 Q5,24 3,9 Q2,3 5,3" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2"/></Canvas></Viewbox></Grid>
                  <TextBlock
                                            Text="Пароль"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        /><Grid><TextBox
                                            Name="PortalRegistrationPasswordBox" Classes="neon-input" Padding="50,10,14,10"
                                            Watermark="От 4 символов"
                                            PasswordChar="●"
                                            TextChanged="PortalRegistrationPasswordChanged"
                                            MaxLength="128"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                        /><Viewbox Width="22" Height="22" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"><Canvas Width="34" Height="34"><Path Data="M8,14 L8,9 A8,8 0 0 1 24,9 L24,14 M4,14 L28,14 L28,31 L4,31 Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2"/></Canvas></Viewbox></Grid>
                  <Button
                                            Name="PortalRegisterButton" Classes="access-primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="22" MinHeight="54"
                                            Click="RegisterPortal"
                                            IsEnabled="{Binding CanRegisterPortal}"
                                            Margin="0,8,0,0"
                                        ><TextBlock
                                                Text="Создать аккаунт"
                                                FontWeight="SemiBold"
                                            /></Button>
                  <Grid ColumnDefinitions="*,Auto,*" Margin="0,4"><Border Height="1" Background="#536365"/><TextBlock Grid.Column="1" Text="или" Margin="14,0" Foreground="{DynamicResource SecondaryTextBrush}"/><Border Grid.Column="2" Height="1" Background="#536365"/></Grid>
                  <Button
                                            Name="BackToPortalLoginButton" Classes="access-secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="20" MinHeight="48"
                                            Click="CancelPortalRegistration"
                                        ><TextBlock
                                                Text="У меня уже есть аккаунт"
                                            /></Button>
                </StackPanel>

                <StackPanel
                                        IsVisible="{Binding IsManagerLoginVisible}"
                                        Spacing="10"
                                    >
                  <TextBlock
                                            Text="ОБСЛУЖИВАНИЕ"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            FontSize="14"
                                        /><TextBlock
                                            Text="Режим менеджера"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            FontSize="21"
                                            FontWeight="SemiBold"
                                        /><TextBlock
                                            Text="Системные действия доступны только менеджеру клуба."
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                            TextWrapping="Wrap"
                                        />
                  <TextBlock
                                            Text="Пароль менеджера"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="14"
                                        /><TextBox
                                            Name="ManagerPasswordBox"
                                            Watermark="Введите пароль"
                                            PasswordChar="●"
                                            TextChanged="ManagerPasswordChanged"
                                            MaxLength="128"
                                        />
                  <Button
                                            Click="EnterMaintenance"
                                            IsEnabled="{Binding CanEnterMaintenance}"
                                            Margin="0,8,0,0"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource AccentTextBrush}"
                                        ><TextBlock
                                                Text="Открыть обслуживание"
                                                FontWeight="SemiBold"
                                            /></Button>
                  <Button
                                            Click="CancelManagerLogin"
                                            Background="Transparent"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                        ><TextBlock
                                                Text="Назад ко входу пользователя"
                                            /></Button>
                </StackPanel>

                <StackPanel
                                        Name="MaintenancePanel"
                                        IsVisible="{Binding IsMaintenanceVisible}"
                                        Spacing="12"
                                    >
                  <TextBlock
                                            Text="ОБСЛУЖИВАНИЕ"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            FontSize="14"
                                        /><TextBlock
                                            Text="Режим менеджера активен"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            FontSize="21"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                        />
                  <Border
                                            Padding="11"
                                            Background="#16314C2C"
                                            BorderBrush="#3AB6F35A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                        ><TextBlock
                                                Text="Доступ менеджера подтверждён. Рабочие действия клиента приостановлены."
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                FontSize="14"
                                                TextWrapping="Wrap"
                                            /></Border>
                  <Button
                                            Click="LockClient"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="{DynamicResource AccentTextBrush}"
                                        ><TextBlock
                                                Text="Закрыть обслуживание"
                                                FontWeight="SemiBold"
                                            /></Button>
                  <Button
                                            Name="OpenDesktopButton"
                                            Click="OpenDesktop"
                                            Background="Transparent"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                        ><TextBlock
                                                Text="Перейти к рабочему столу"
                                            /></Button>
                </StackPanel>
                <Border
                                        Name="AccessFeedbackPanel"
                                        Grid.Row="1"
                                        IsVisible="{Binding IsAccessFeedbackVisible}"
                                        Margin="0,12,0,0"
                                        Padding="12"
                                        Background="#3A241D"
                                        BorderBrush="#D9854E"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                    ><Grid
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10"
                                        ><Border
                                                Width="24"
                                                Height="24"
                                                Background="#E8A15B"
                                                CornerRadius="12"
                                                VerticalAlignment="Top"
                                            ><TextBlock
                                                    Text="!"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="#21140E"
                                                    FontWeight="Bold"
                                                /></Border><StackPanel
                                                Grid.Column="1"
                                                Spacing="3"
                                            ><TextBlock
                                                    Text="Не удалось выполнить действие"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                /><TextBlock
                                                    Text="{Binding AccessMessage}"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    FontSize="14"
                                                    TextWrapping="Wrap"
                                                /></StackPanel></Grid></Border>
              </Grid>
                </Border>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,150,0,0" Spacing="24">
              <Grid ColumnDefinitions="60,*" ColumnSpacing="18"><Border Width="60" Height="60" Background="#A0102316" BorderBrush="#405B45" BorderThickness="1" CornerRadius="12"><Viewbox Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="38" Height="38"><Path Data="M5,9 C5,3 12,3 14,5 L22,5 C24,3 31,3 31,9 L35,24 C36,29 31,31 28,27 L23,22 L13,22 L8,27 C5,31 0,29 1,24 Z M12,10 L12,18 M8,14 L16,14 M23,11 L23,13 M27,16 L27,18" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock IsVisible="{Binding IsUserLoginVisible}" Text="Самые топовые игры" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock IsVisible="{Binding IsPortalRegistrationVisible}" Text="Быстрый старт" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock IsVisible="{Binding IsUserLoginVisible}" Text="Быстрый запуск и автообновления" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock IsVisible="{Binding IsPortalRegistrationVisible}" Text="Покупка времени и тарифов" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid>
              <Grid ColumnDefinitions="60,*" ColumnSpacing="18"><Border Width="60" Height="60" Background="#A0102316" BorderBrush="#405B45" BorderThickness="1" CornerRadius="12"><Viewbox Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="38" Height="38"><Path Data="M18,1 A17,17 0 1 1 17.9,1 M18,7 L18,18 L26,23" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock IsVisible="{Binding IsUserLoginVisible}" Text="Удобное управление" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock IsVisible="{Binding IsPortalRegistrationVisible}" Text="Личный профиль" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock IsVisible="{Binding IsUserLoginVisible}" Text="Покупка времени и тарифов" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock IsVisible="{Binding IsPortalRegistrationVisible}" Text="История и управление пакетами" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid>
              <Grid ColumnDefinitions="60,*" ColumnSpacing="18"><Border Width="60" Height="60" Background="#A0102316" BorderBrush="#405B45" BorderThickness="1" CornerRadius="12"><Viewbox Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="38" Height="38"><Path Data="M18,1 L32,7 L31,21 Q27,31 18,35 Q9,31 5,21 L4,7 Z M11,17 L16,22 L25,12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Canvas></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="Комфортная атмосфера" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Играй с удовольствием" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid>
            </StackPanel>
          </Grid>
        </Viewbox>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4"><TextBlock Text="{Binding ConnectionMessage}" Foreground="{Binding ConnectionColor}" FontSize="12"/><TextBlock Name="HostDisclaimer" IsVisible="False"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CurrentWorkstationLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
        </Grid>
      </Grid>
    </Grid>

    <!-- Личный кабинет. Нативное компактное окно и трей намеренно остаются за пределами Linux-host. -->
    <ScrollViewer
                IsVisible="{Binding IsPortalContentVisible}"
                Margin="12"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
            >
      <StackPanel HorizontalAlignment="Stretch" Spacing="10">
        <Grid
                        Margin="4,2"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="6"
                    ><TextBlock
                            Text="HUBSHELL"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="Bold"
                            FontSize="14"
                        /><Button
                            Name="HideToTrayButton"
                            Grid.Column="1"
                            Click="HideToTray"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                        ><TextBlock Text="Скрыть" /></Button><Button
                            Grid.Column="2"
                            Click="Logout"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                        Name="PortalLogoutButton"
                        ><TextBlock Text="Выйти" /></Button></Grid>
        <Border
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="13"
                    ><StackPanel Spacing="3"><TextBlock
                                Text="ВЫ ВОШЛИ КАК"
                                Foreground="{DynamicResource MutedTextBrush}"
                                FontSize="9"
                            /><TextBlock
                                Text="{Binding PortalAccountSummary}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="18"
                                FontWeight="SemiBold"
                            /><TextBlock
                                Text="{Binding PortalContactSummary}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="11"
                            /></StackPanel></Border>
        <Border
                        IsVisible="{Binding IsPortalPasswordSetupVisible}"
                        Background="#24331C"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="13"
                    ><StackPanel Spacing="9"><TextBlock
                                Text="Обновите пароль"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="17"
                                FontWeight="SemiBold"
                            /><TextBlock
                                Text="Администратор сбросил старый пароль. Задайте новый, чтобы продолжить."
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="11"
                                TextWrapping="Wrap"
                            /><TextBlock
                                Text="{Binding AccessMessage}"
                                IsVisible="{Binding IsAccessFeedbackVisible}"
                                Foreground="{DynamicResource SignalBrush}"
                                FontSize="10"
                                TextWrapping="Wrap"
                            /><TextBox
                                Name="PortalPasswordSetupBox"
                                Watermark="Новый пароль"
                                PasswordChar="●"
                                TextChanged="PortalPasswordSetupChanged"
                                MaxLength="128"
                            /><TextBox
                                Name="PortalPasswordSetupConfirmationBox"
                                Watermark="Повторите пароль"
                                PasswordChar="●"
                                TextChanged="PortalPasswordSetupConfirmationChanged"
                                MaxLength="128"
                            /><Button
                                Click="SetPortalPassword"
                                IsEnabled="{Binding CanSetPortalPassword}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentTextBrush}"
                            ><TextBlock
                                    Text="Сохранить новый пароль"
                                    FontWeight="SemiBold"
                                /></Button></StackPanel></Border>
        <Border
                        IsVisible="{Binding IsPortalReadyVisible}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                    ><Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8"
                        ><Ellipse
                                Width="7"
                                Height="7"
                                Fill="{Binding ConnectionColor}"
                                VerticalAlignment="Center"
                            /><TextBlock
                                Grid.Column="1"
                                Text="{Binding ConnectionMessage}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="10"
                            /><TextBlock
                                Grid.Column="2"
                                Text="{Binding CurrentWorkstationLabel}"
                                Foreground="{DynamicResource MutedTextBrush}"
                                FontSize="10"
                            /></Grid></Border>
        <Border
                        IsVisible="{Binding IsPortalReadyVisible}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11"
                    ><Grid
                            ColumnDefinitions="*,1.25*"
                            ColumnSpacing="12"
                        ><StackPanel Spacing="4"><TextBlock
                                    Text="БАЛАНС"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    FontSize="9"
                                /><TextBlock
                                    Text="{Binding PortalBalanceAmountSummary}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                /><TextBlock
                                    Text="{Binding PortalBonusSummary}"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    FontSize="10"
                                /></StackPanel><StackPanel
                                IsVisible="{Binding IsPortalBalanceTimeVisible}"
                                Grid.Column="1"
                                Spacing="4"
                            ><TextBlock
                                    Text="ОСТАТОК ПО БАЛАНСУ"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    FontSize="9"
                                /><TextBlock
                                    Text="{Binding PortalAvailableTimeValue}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                /><TextBlock
                                    Text="расчёт по текущей ставке сервера"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    FontSize="10"
                                /></StackPanel></Grid></Border>
        <Border
                        Name="UpcomingBookingPanel"
                        IsVisible="{Binding IsUpcomingBookingVisible}"
                        Background="#1B2733"
                        BorderBrush="#4D61D8FF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11"
                    ><StackPanel Spacing="3"><TextBlock
                                Text="БЛИЖАЙШАЯ БРОНЬ НА ЭТОМ МЕСТЕ"
                                Foreground="{DynamicResource SignalBrush}"
                                FontSize="9"
                            /><TextBlock
                                Text="{Binding UpcomingBookingTitle}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontWeight="SemiBold"
                            /><TextBlock
                                Text="{Binding UpcomingBookingDetails}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="10"
                                TextWrapping="Wrap"
                            /></StackPanel></Border>
        <Border
                        IsVisible="{Binding IsActiveSessionVisible}"
                        Background="#122130"
                        BorderBrush="#4D61D8FF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                    ><StackPanel Spacing="9"><Grid
                                ColumnDefinitions="*,Auto"
                            ><TextBlock
                                    Text="●  СЕССИЯ АКТИВНА"
                                    Foreground="{DynamicResource SignalBrush}"
                                    FontSize="10"
                                /><TextBlock
                                    Grid.Column="1"
                                    Text="{Binding CurrentWorkstationLabel}"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    FontSize="10"
                                /></Grid><Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="10"
                            ><StackPanel Spacing="3"><TextBlock
                                        Text="ТЕКУЩИЙ РЕЖИМ"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        FontSize="9"
                                    /><TextBlock
                                        Text="{Binding CurrentSessionModeSummary}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                    /><TextBlock
                                        Text="{Binding CurrentSessionTariffSummary}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        FontSize="10"
                                        TextWrapping="Wrap"
                                    /></StackPanel><StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Spacing="3"
                                ><TextBlock
                                        Text="ОСТАЛОСЬ"
                                        Foreground="{DynamicResource SignalBrush}"
                                        FontSize="9"
                                        HorizontalAlignment="Right"
                                    /><TextBlock
                                        Text="{Binding ActiveTimeSummary}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap"
                                    /></StackPanel></Grid><Button
                                HorizontalAlignment="Right"
                                Click="StopCurrentSession"
                                IsEnabled="{Binding CanStopActiveSession}"
                                Background="Transparent"
                                Foreground="{DynamicResource AccentBrush}"
                            Name="StopActiveSessionButton"
                            ><TextBlock
                                    Text="Выйти"
                                    FontSize="10"
                                /></Button></StackPanel></Border>
        <Border
                        IsVisible="{Binding IsPortalNotificationVisible}"
                        Background="#25351E"
                        BorderBrush="#45B6F35A"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10"
                    ><Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                        ><TextBlock
                                Text="{Binding PortalNotification}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="10"
                                TextWrapping="Wrap"
                            /><Button
                                Grid.Column="1"
                                Click="DismissSessionNotification"
                                Background="Transparent"
                                Foreground="{DynamicResource AccentBrush}"
                            ><TextBlock
                                    Text="×"
                                    FontSize="16"
                                /></Button></Grid></Border>
        <Border
                        IsVisible="{Binding IsTariffsVisible}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11"
                    ><StackPanel Spacing="8"><TextBlock
                                Text="Тарифы времени"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                            /><ItemsControl
                                Name="PortalTariffList"
                                ItemsSource="{Binding PortalTariffs}"
                            ><ItemsControl.ItemTemplate><DataTemplate><Border
                                            Background="{DynamicResource InnerCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9"
                                            Margin="0,2"
                                        ><Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="8"
                                            ><StackPanel Spacing="2"><TextBlock
                                                        Text="{Binding Name}"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                    /><TextBlock
                                                        Text="{Binding DurationSummary}"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        FontSize="10"
                                                    /><TextBlock
                                                        Text="{Binding PriceSummary}"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        FontSize="10"
                                                    /></StackPanel><Button
                                                    Grid.Column="1"
                                                    Tag="{Binding Id}"
                                                    Click="PurchaseTariff"
                                                    Classes="widget-primary"
                                                ><TextBlock
                                                        Text="Купить"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                    /></Button></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border
                        IsVisible="{Binding IsPortalReadyVisible}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11"
                    ><StackPanel Spacing="7"><TextBlock
                                Text="Пакеты времени"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                            /><ItemsControl
                                Name="PortalEntitlementQueueList"
                                ItemsSource="{Binding PortalEntitlementQueue}"
                            ><ItemsControl.ItemTemplate><DataTemplate><TextBlock
                                            Text="{Binding}"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            FontSize="10"
                                            TextWrapping="Wrap"
                                            Margin="0,2"
                                        /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button
                                Click="ActivateFirstPortalEntitlement"
                                IsEnabled="{Binding CanActivatePortalEntitlement}"
                                Classes="widget-primary"
                            ><TextBlock
                                    Text="Активировать сохранённый пакет"
                                    FontSize="10"
                                /></Button></StackPanel></Border>
        <Button
                        Click="ToggleTransferPanel"
                        IsVisible="{Binding IsPortalReadyVisible}"
                        Classes="widget-secondary"
                    ><TextBlock
                            Text="{Binding TransferToggleLabel}"
                            FontSize="10"
                        /></Button>
        <Border
                        Name="TransferPanel"
                        IsVisible="{Binding IsTransferPanelVisible}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11"
                    ><StackPanel Spacing="8"><TextBlock
                                Text="Перенос сессии"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                            /><TextBlock
                                Text="{Binding TransferMessage}"
                                IsVisible="{Binding IsTransferMessageVisible}"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="10"
                                TextWrapping="Wrap"
                            /><TextBlock
                                Text="После подтверждения войдите в этот же аккаунт на другом ПК. Мы дождёмся входа и перенесём текущую сессию автоматически."
                                IsVisible="{Binding IsTransferWaiting}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="10"
                                TextWrapping="Wrap"
                            /><ProgressBar
                                IsVisible="{Binding IsTransferWaiting}"
                                IsIndeterminate="True"
                                Width="120"
                                HorizontalAlignment="Left"
                            /><Button
                                Click="CreateTransferOffer"
                                IsEnabled="{Binding CanCreateTransferOffer}"
                                Classes="widget-secondary"
                            ><TextBlock
                                    Text="Пересесть на другой ПК"
                                    FontSize="10"
                                /></Button></StackPanel></Border>
        <Button
                        Name="OpenAccountHistoryButton"
                        IsVisible="{Binding IsPortalReadyVisible}"
                        Click="OpenAccountHistory"
                        Classes="widget-secondary"
                    ><TextBlock
                            Text="История аккаунта"
                            FontSize="10"
                        /></Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  </Border>
</Window>
